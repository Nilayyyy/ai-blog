---
import { SITE_TITLE } from '../config';

interface Props {
  title: string;
  description: string;
  canonical?: string | null;
}
const { title, description, canonical } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style>
      :root { --bg: #fff; --fg: #1c1c1c; --muted: #666; --accent: #0b5fff; --code: #f3f3f3; }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #111; --fg: #e8e8e8; --muted: #9a9a9a; --accent: #7aa7ff; --code: #1d1d1d; }
      }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 18px/1.65 system-ui, sans-serif; }
      main, header, footer { max-width: 42rem; margin: 0 auto; padding: 1rem; }
      header { display: flex; justify-content: space-between; align-items: baseline; }
      a { color: var(--accent); }
      header a.brand { color: var(--fg); font-weight: 700; text-decoration: none; }
      .muted { color: var(--muted); font-size: 0.9rem; }
      pre { background: var(--code); padding: 1rem; overflow-x: auto; border-radius: 6px; font-size: 0.85rem; }
      code { background: var(--code); padding: 0.1em 0.3em; border-radius: 4px; }
      pre code { background: none; padding: 0; }
      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin: 0 0 1.5rem; }
      ul.posts a { font-size: 1.15rem; font-weight: 600; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">{SITE_TITLE}</a>
      <a class="muted" href="/rss.xml">RSS</a>
    </header>
    <main><slot /></main>
    <footer class="muted">&copy; {new Date().getFullYear()} {SITE_TITLE}</footer>
  </body>
</html>
